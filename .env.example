# Lumina Hub — Environment Variables
# Copy to .env and fill in real values for production.

# Database (PostgreSQL required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lumina?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Seeded admin account (used by prisma/seed.ts)
ADMIN_EMAIL="admin@luminahub.co.uk"
ADMIN_PASSWORD="change-me-strong-password"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Lumina Hub <orders@luminahub.co.uk>"

# Images — "local" | "cloudinary" | "r2"
IMAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional R2 / S3-compatible
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
