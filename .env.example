# Lumina Hub — Environment Variables
# Copy to .env and fill in real values for production / preview.

# Database (PostgreSQL required — Neon on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lumina?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://luminahub-lyart.vercel.app"
NEXTAUTH_URL="https://luminahub-lyart.vercel.app"

# Seeded / admin account (prisma seed or import scripts)
ADMIN_EMAIL="admin@luminahub.co.uk"
ADMIN_PASSWORD="change-me-strong-password"

# --- Commerce (brief SoT) -------------------------------------------------
# Shopify Storefront API — REQUIRED for live hosted checkout
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_TOKEN="shpat_or_storefront_token"
SHOPIFY_STOREFRONT_API_VERSION="2025-01"
# Optional Admin API for authoritative catalog sync (not public products.json)
SHOPIFY_ADMIN_TOKEN=""
SHOPIFY_API_VERSION="2025-01"

# Stripe — optional legacy / interim only (not the brief source of truth)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email (Resend) — required for contact / order emails
RESEND_API_KEY="re_..."
EMAIL_FROM="Lumina Hub <Sales@luminahub.co.uk>"

# Images — "local" | "cloudinary" | "r2"
# Catalog images live under public/media/products when IMAGE_PROVIDER=local
IMAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Site
NEXT_PUBLIC_SITE_URL="https://luminahub-lyart.vercel.app"
