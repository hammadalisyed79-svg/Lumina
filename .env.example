# Lumina Hub — Environment Variables
# Copy to .env and fill in real values for production / preview.

# Database (PostgreSQL required — Neon on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lumina?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://luminahub-lyart.vercel.app"
NEXTAUTH_URL="https://luminahub-lyart.vercel.app"

# Seeded / admin account (prisma seed or import scripts)
ADMIN_EMAIL="admin@luminahub.co.uk"
ADMIN_PASSWORD="change-me-strong-password"

# --- Commerce (independent Stripe checkout) --------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Optional: Shopify IDs may exist on imported catalogue rows for reference only.
# They are NOT used for checkout on this site.
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""
SHOPIFY_ADMIN_TOKEN=""
SHOPIFY_API_VERSION="2025-01"

# Email (Resend) — required for contact / order emails
RESEND_API_KEY="re_..."
EMAIL_FROM="Lumina Hub <Sales@luminahub.co.uk>"

# Images — "local" | "cloudinary" | "r2"
# Catalog images live under public/media/products when IMAGE_PROVIDER=local
IMAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Site
NEXT_PUBLIC_SITE_URL="https://luminahub-lyart.vercel.app"

# Studio chat (OpenAI) — local assistant on the storefront
OPENAI_API_KEY="sk-..."
OPENAI_CHAT_MODEL="gpt-4o-mini"
