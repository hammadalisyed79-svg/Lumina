generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  TRADE
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum ProductType {
  LAMPSHADE
  FABRIC
  CUSHION
  KIT
  ACCESSORY
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  PRODUCTION
  QC
  PACKED
  SHIPPED
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ProductionStatus {
  NONE
  QUEUED
  IN_PRODUCTION
  QC
  PACKED
  DISPATCHED
  COMPLETE
}

enum EnquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum InventoryKind {
  FINISHED
  KIT
  FABRIC
  COMPONENT
  OTHER
}

enum HomepageSectionType {
  HERO
  SHOP_BY_SHAPE
  FEATURED_COLLECTION
  DESIGN_YOUR_SHADE
  SHOP_BY_MOOD
  EDITORIAL
  BEST_SELLERS
  CUSTOMER_HOMES
  REVIEWS
  TRADE
  NEWSLETTER
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BespokeStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  DECLINED
  COMPLETED
  CLOSED
}

enum TradeStatus {
  NEW
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
}

enum ShippingCalc {
  FLAT
  FREE_ABOVE
  WEIGHT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  wishlist      Wishlist?
  cart          Cart?
  reviews       Review[]
  savedDesigns  SavedDesign[]
  tradeApps     TradeApplication[]
  bespoke       BespokeEnquiry[]
  auditLogs       AuditLog[]
  couponsUsed     CouponRedemption[]
  contactEnquiries ContactEnquiry[]
  staffNotes      CustomerNote[] @relation("CustomerNotes")
  notesAuthored   CustomerNote[] @relation("NoteAuthor")

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  fullName   String
  line1      String
  line2      String?
  city       String
  county     String?
  postcode   String
  country    String   @default("GB")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  imageUrl    String?
  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  published   Boolean  @default(true)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    CollectionProduct[]

  @@index([published, sortOrder])
}

model Product {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  subtitle        String?
  description     String      @db.Text
  shortDesc       String?
  type            ProductType @default(LAMPSHADE)
  shapeKey        String?
  moodTags        String[]    @default([])
  colourTags      String[]    @default([])
  patternTags     String[]    @default([])
  material        String?
  basePrice       Decimal     @db.Decimal(10, 2)
  compareAtPrice  Decimal?    @db.Decimal(10, 2)
  published       Boolean     @default(true)
  archived        Boolean     @default(false)
  featured        Boolean     @default(false)
  bestseller      Boolean     @default(false)
  handmade        Boolean     @default(true)
  leadTimeDays    Int         @default(7)
  seoTitle        String?
  seoDesc         String?
  seoKeywords     String[]    @default([])
  configEnabled   Boolean     @default(true)
  shopifyProductId String?    @unique
  shopifyHandle   String?
  sourceWebsite   String?
  sourceUrl       String?
  sourceHandle    String?     @unique
  sourceTitle     String?     @db.Text
  sourceOriginalDescription String? @db.Text
  sourceAvailability String?
  availabilityReviewed Boolean @default(false)
  /// When true, re-import preserves title/description/SEO/published (admin-edited customer fields).
  adminFieldsLocked Boolean @default(false)
  sourceImportedAt DateTime?
  migrationStatus String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  images          ProductImage[]
  variants        ProductVariant[]
  collections     CollectionProduct[]
  reviews         Review[]
  relatedFrom     ProductRelation[] @relation("ProductFrom")
  relatedTo       ProductRelation[] @relation("ProductTo")
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  eligibleShapes  ProductShape[]
  eligibleFabrics ProductFabric[]
  eligibleSizes   ProductSize[]
  eligibleLinings ProductLining[]
  eligibleFittings ProductFitting[]
  inventoryItems  InventoryItem[]

  @@index([type, published])
  @@index([archived])
  @@index([featured])
  @@index([bestseller])
  @@index([shapeKey])
  @@index([shopifyHandle])
  @@index([sourceHandle])
  @@index([migrationStatus])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  url         String
  alt         String?
  sortOrder   Int     @default(0)
  isPrimary   Boolean @default(false)
  sourceUrl   String?
  width       Int?
  height      Int?
  contentHash String?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([contentHash])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  sku              String   @unique
  title            String
  fabricId         String?
  sizeId           String?
  liningId         String?
  fittingId        String?
  priceOverride    Decimal? @db.Decimal(10, 2)
  stock            Int      @default(100)
  active           Boolean  @default(true)
  shopifyVariantId String?  @unique
  option1          String?
  option2          String?
  option3          String?
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fabric           Fabric?  @relation(fields: [fabricId], references: [id])
  size             Size?    @relation(fields: [sizeId], references: [id])
  lining           Lining?  @relation(fields: [liningId], references: [id])
  fitting          Fitting? @relation(fields: [fittingId], references: [id])
  orderItems       OrderItem[]

  @@index([productId])
  @@index([fabricId])
  @@index([sizeId])
}

model ProductRelation {
  fromId String
  toId   String
  from   Product @relation("ProductFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Product @relation("ProductTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

enum FabricRepeatMode {
  REPEAT
  COVER
  CONTAIN
}

model Fabric {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  internalCode String?
  description String?  @db.Text
  colour      String?
  material    String?
  pattern     String?
  imageUrl    String?
  swatchUrl   String?
  /// Dedicated flat/close-up texture for the configurator renderer
  textureImage    String?
  patternScale    Float    @default(1)
  patternOffsetX  Float    @default(0)
  patternOffsetY  Float    @default(0)
  patternRotation Float    @default(0)
  repeatMode      FabricRepeatMode @default(REPEAT)
  usableAsTexture Boolean  @default(false)
  priceMod    Decimal  @default(0) @db.Decimal(10, 2)
  stockQty    Int?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  variants    ProductVariant[]
  designs     SavedDesign[]
  products    ProductFabric[]
  inventoryItems InventoryItem[]
  shapes      ShapeFabric[]
}

model Size {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shapeId     String?
  diameterCm  Decimal? @db.Decimal(6, 2)
  heightCm    Decimal? @db.Decimal(6, 2)
  widthCm     Decimal? @db.Decimal(6, 2)
  depthCm     Decimal? @db.Decimal(6, 2)
  topDiameterCm    Decimal? @db.Decimal(6, 2)
  bottomDiameterCm Decimal? @db.Decimal(6, 2)
  displayUnit String   @default("cm")
  priceMod    Decimal  @default(0) @db.Decimal(10, 2)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  shape       Shape?   @relation(fields: [shapeId], references: [id])
  variants    ProductVariant[]
  designs     SavedDesign[]
  products    ProductSize[]
  shapes      ShapeSize[]

  @@index([shapeId])
}

model Lining {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  colour    String?
  swatchUrl String?
  description String?
  /// Exact hex used by the configurator interior renderer
  rendererHex      String?
  /// 0–1 reflective warmth hint for Light On preview
  reflectivityHint Float?
  priceMod  Decimal @default(0) @db.Decimal(10, 2)
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  variants  ProductVariant[]
  designs   SavedDesign[]
  products  ProductLining[]
  shapes    ShapeLining[]
}

model Fitting {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  imageUrl    String?
  compatibility String?
  /// Explicit use types: table | floor | ceiling. Empty = all uses.
  useTypes    String[] @default([])
  priceMod    Decimal @default(0) @db.Decimal(10, 2)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  variants    ProductVariant[]
  designs     SavedDesign[]
  products    ProductFitting[]
  shapes      ShapeFitting[]
}

model Shape {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  imageUrl    String?
  basePrice   Decimal @db.Decimal(10, 2)
  priceMod    Decimal @default(0) @db.Decimal(10, 2)
  /// Explicit use types: table | floor | ceiling. Empty = all uses.
  useTypes    String[] @default([])
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  designs     SavedDesign[]
  sizes       Size[]
  products    ProductShape[]
  shapeSizes    ShapeSize[]
  shapeFabrics  ShapeFabric[]
  shapeLinings  ShapeLining[]
  shapeFittings ShapeFitting[]
}

/// Explicit Shape ↔ Size eligibility for the configurator
model ShapeSize {
  shapeId     String
  sizeId      String
  needsReview Boolean @default(false)
  source      String?
  shape       Shape   @relation(fields: [shapeId], references: [id], onDelete: Cascade)
  size        Size    @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@id([shapeId, sizeId])
  @@index([sizeId])
}

model ShapeFabric {
  shapeId     String
  fabricId    String
  needsReview Boolean @default(false)
  source      String?
  shape       Shape   @relation(fields: [shapeId], references: [id], onDelete: Cascade)
  fabric      Fabric  @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@id([shapeId, fabricId])
  @@index([fabricId])
}

model ShapeLining {
  shapeId     String
  liningId    String
  needsReview Boolean @default(false)
  source      String?
  shape       Shape   @relation(fields: [shapeId], references: [id], onDelete: Cascade)
  lining      Lining  @relation(fields: [liningId], references: [id], onDelete: Cascade)

  @@id([shapeId, liningId])
  @@index([liningId])
}

model ShapeFitting {
  shapeId     String
  fittingId   String
  needsReview Boolean @default(false)
  source      String?
  shape       Shape   @relation(fields: [shapeId], references: [id], onDelete: Cascade)
  fitting     Fitting @relation(fields: [fittingId], references: [id], onDelete: Cascade)

  @@id([shapeId, fittingId])
  @@index([fittingId])
}

model ProductShape {
  productId String
  shapeId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  shape     Shape   @relation(fields: [shapeId], references: [id], onDelete: Cascade)

  @@id([productId, shapeId])
}

model ProductFabric {
  productId String
  fabricId  String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fabric    Fabric  @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@id([productId, fabricId])
}

model ProductSize {
  productId String
  sizeId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Size    @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@id([productId, sizeId])
}

model ProductLining {
  productId String
  liningId  String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  lining    Lining  @relation(fields: [liningId], references: [id], onDelete: Cascade)

  @@id([productId, liningId])
}

model ProductFitting {
  productId String
  fittingId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fitting   Fitting @relation(fields: [fittingId], references: [id], onDelete: Cascade)

  @@id([productId, fittingId])
}

model Wishlist {
  id     String         @id @default(cuid())
  userId String         @unique
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model SavedDesign {
  id          String   @id @default(cuid())
  userId      String?
  guestKey    String?
  name        String?
  shapeId     String?
  fabricId    String?
  sizeId      String?
  liningId    String?
  fittingId   String?
  configJson  Json
  unitPrice   Decimal  @db.Decimal(10, 2)
  previewUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shape       Shape?   @relation(fields: [shapeId], references: [id])
  fabric      Fabric?  @relation(fields: [fabricId], references: [id])
  size        Size?    @relation(fields: [sizeId], references: [id])
  lining      Lining?  @relation(fields: [liningId], references: [id])
  fitting     Fitting? @relation(fields: [fittingId], references: [id])

  @@index([userId])
  @@index([guestKey])
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String?
  email             String
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(UNPAID)
  productionStatus  ProductionStatus @default(NONE)
  currency          String        @default("gbp")
  subtotal          Decimal       @db.Decimal(10, 2)
  shippingTotal     Decimal       @db.Decimal(10, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(10, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(10, 2)
  total             Decimal       @db.Decimal(10, 2)
  couponCode        String?
  shippingMethodId  String?
  stripeSessionId   String?       @unique
  stripePaymentIntent String?     @unique
  shopifyCartId     String?       @unique
  shopifyOrderId    String?       @unique
  shippingName      String?
  shippingLine1     String?
  shippingLine2     String?
  shippingCity      String?
  shippingCounty    String?
  shippingPostcode  String?
  shippingCountry   String?       @default("GB")
  shippingPhone     String?
  trackingProvider  String?
  trackingNumber    String?
  dispatchedAt      DateTime?
  staffNotes        String?       @db.Text
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User?         @relation(fields: [userId], references: [id])
  shippingMethod    ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  items             OrderItem[]
  events            OrderEvent[]
  couponRedemptions CouponRedemption[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([productionStatus])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  title       String
  sku         String?
  quantity    Int
  unitPrice   Decimal         @db.Decimal(10, 2)
  lineTotal   Decimal         @db.Decimal(10, 2)
  configJson  Json?
  imageUrl    String?
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String
  meta      Json?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Atomic counter for LH-###### order numbers
model OrderSequence {
  id        Int @id @default(1)
  nextValue Int @default(1)
}

/// Server-persisted bag for signed-in users (guest bag lives in localStorage)
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  itemsJson Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())
  payload     Json?
}

model ShopifyWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  topic       String
  processedAt DateTime @default(now())
  payload     Json?
}

model Review {
  id               String        @id @default(cuid())
  productId        String
  userId           String?
  author           String
  email            String?
  rating           Int
  title            String?
  body             String        @db.Text
  status           ReviewStatus  @default(PENDING)
  verifiedPurchase Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [userId], references: [id])
  images           ReviewImage[]

  @@index([productId, status])
  @@index([status])
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Decimal    @db.Decimal(10, 2)
  minSubtotal   Decimal?   @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int        @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  redemptions   CouponRedemption[]
}

model CouponRedemption {
  id       String   @id @default(cuid())
  couponId String
  orderId  String
  userId   String?
  createdAt DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([couponId, orderId])
}

model ShippingMethod {
  id           String       @id @default(cuid())
  name         String
  description  String?
  calcType     ShippingCalc @default(FLAT)
  price        Decimal      @db.Decimal(10, 2)
  freeAbove    Decimal?     @db.Decimal(10, 2)
  estimatedDays String?
  active       Boolean      @default(true)
  sortOrder    Int          @default(0)
  orders       Order[]
}

model TradeApplication {
  id                 String      @id @default(cuid())
  userId             String?
  businessName       String
  contactName        String
  email              String
  phone              String?
  website            String?
  businessType       String?
  estimatedVolume    String?
  vatNumber          String?
  address            String?     @db.Text
  message            String?     @db.Text
  status             TradeStatus @default(NEW)
  discountPercent    Decimal?    @db.Decimal(5, 2)
  tradePricingEnabled Boolean    @default(false)
  adminNotes         String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User?       @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([email])
}

model BespokeEnquiry {
  id          String        @id @default(cuid())
  userId      String?
  name        String
  email       String
  phone       String?
  subject     String?
  message     String        @db.Text
  attachments Json?
  status      BespokeStatus @default(NEW)
  adminNotes  String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User?         @relation(fields: [userId], references: [id])

  @@index([status])
}

model MediaAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  filename  String?
  alt       String?
  caption   String?
  type      String   @default("image")
  width     Int?
  height    Int?
  provider  String   @default("local")
  folder    String?
  createdAt DateTime @default(now())

  @@index([folder])
  @@index([type])
  @@index([createdAt])
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   Json
  published Boolean  @default(true)
  seoTitle  String?
  seoDesc   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  source         String?
  status         String    @default("subscribed")
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  module      String
  description String?
  roles       RolePermission[]

  @@index([module])
}

model RolePermission {
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
}

model InventoryItem {
  id           String              @id @default(cuid())
  sku          String              @unique
  name         String
  kind         InventoryKind       @default(OTHER)
  productId    String?
  fabricId     String?
  available    Int                 @default(0)
  reserved     Int                 @default(0)
  incoming     Int                 @default(0)
  reorderLevel Int                 @default(0)
  trackStock   Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  product      Product?            @relation(fields: [productId], references: [id])
  fabric       Fabric?             @relation(fields: [fabricId], references: [id])
  movements    InventoryMovement[]

  @@index([kind])
  @@index([productId])
  @@index([fabricId])
}

model InventoryMovement {
  id        String        @id @default(cuid())
  itemId    String
  delta     Int
  reason    String
  note      String?
  userId    String?
  createdAt DateTime      @default(now())
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model ContactEnquiry {
  id        String        @id @default(cuid())
  userId    String?
  name      String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String?
  body       String   @db.Text
  createdAt  DateTime @default(now())
  customer   User     @relation("CustomerNotes", fields: [customerId], references: [id], onDelete: Cascade)
  author     User?    @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([customerId])
}

model NavigationMenu {
  id        String           @id @default(cuid())
  key       String           @unique
  label     String
  items     NavigationItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model NavigationItem {
  id        String          @id @default(cuid())
  menuId    String
  label     String
  url       String
  sortOrder Int             @default(0)
  enabled   Boolean         @default(true)
  parentId  String?
  menu      NavigationMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent    NavigationItem? @relation("NavChildren", fields: [parentId], references: [id])
  children  NavigationItem[] @relation("NavChildren")

  @@index([menuId, sortOrder])
}

model HomepageSection {
  id        String              @id @default(cuid())
  type      HomepageSectionType
  title     String?
  subtitle  String?
  body      String?             @db.Text
  imageUrl  String?
  ctaLabel  String?
  ctaHref   String?
  payload   Json?
  sortOrder Int                 @default(0)
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt
  createdAt DateTime            @default(now())

  @@index([enabled, sortOrder])
  @@index([type])
}
